{
	"name": "PL_Child_Copy",
	"properties": {
		"activities": [
			{
				"name": "Switch_SourceType",
				"type": "Switch",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@pipeline().parameters.SourceType",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "ON_PREM_SQL",
							"activities": [
								{
									"name": "Copy_OnPrem",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "SqlServerSource",
											"sqlReaderQuery": "@if(\n  equals(pipeline().parameters.LoadType, 'FULL'),\n  concat(\n    'SELECT * FROM [',\n    pipeline().parameters.SchemaName,\n    '].[',\n    pipeline().parameters.SourceTable,\n    ']'\n  ),\n  concat(\n    'SELECT * FROM [',\n    pipeline().parameters.SchemaName,\n    '].[',\n    pipeline().parameters.SourceTable,\n    '] WHERE [',\n    pipeline().parameters.WatermarkColumn,\n    '] > ''',\n    pipeline().parameters.LastWatermark,\n    ''''\n  )\n)",
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_OnPrem_SQL",
											"type": "DatasetReference",
											"parameters": {
												"SchemaName": {
													"value": "@pipeline().parameters.SchemaName",
													"type": "Expression"
												},
												"TableName": {
													"value": "@pipeline().parameters.SourceTable",
													"type": "Expression"
												},
												"ServerName": {
													"value": "@pipeline().parameters.ServerName",
													"type": "Expression"
												},
												"DatabaseName": {
													"value": "@pipeline().parameters.DatabaseName",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_ADLS_Parquet",
											"type": "DatasetReference",
											"parameters": {
												"ContainerName": "landing",
												"FolderPath": {
													"value": "@concat(\n    pipeline().parameters.TargetFolder,\n    '/year=', formatDateTime(utcNow(),'yyyy'),\n    '/month=', formatDateTime(utcNow(),'MM'),\n    '/day=', formatDateTime(utcNow(),'dd')\n)",
													"type": "Expression"
												},
												"FileName": {
													"value": "@concat(pipeline().parameters.SourceTable,'_',pipeline().RunId,'.parquet')",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						},
						{
							"value": "AZURE_SQL",
							"activities": [
