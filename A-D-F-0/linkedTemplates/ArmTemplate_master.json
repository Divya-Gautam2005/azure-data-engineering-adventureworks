{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "A-D-F-0"
		},
		"LS_ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS'"
		},
		"LS_Azure_SQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_Azure_SQL'"
		},
		"LS_Databricks_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'LS_Databricks'"
		},
		"LS_OnPrem_SQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_OnPrem_SQL'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://divya00.dfs.core.windows.net/"
		},
		"LS_Azure_SQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "@{linkedService().ServerName}"
		},
		"LS_Azure_SQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().DatabaseName}"
		},
		"LS_Azure_SQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"LS_OnPrem_SQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "@{linkedService().ServerName}"
		},
		"LS_OnPrem_SQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().DatabaseName}"
		},
		"LS_OnPrem_SQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "DIVYAGAUTAM\\Divya Gautam"
		},
		"LS_REST_API_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://open.er-api.com"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "A-D-F-0_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_accountKey": {
						"value": "[parameters('LS_ADLS_accountKey')]"
					},
					"LS_Azure_SQL_password": {
						"value": "[parameters('LS_Azure_SQL_password')]"
					},
					"LS_Databricks_accessToken": {
						"value": "[parameters('LS_Databricks_accessToken')]"
					},
					"LS_OnPrem_SQL_password": {
						"value": "[parameters('LS_OnPrem_SQL_password')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_Azure_SQL_properties_typeProperties_server": {
						"value": "[parameters('LS_Azure_SQL_properties_typeProperties_server')]"
					},
					"LS_Azure_SQL_properties_typeProperties_database": {
						"value": "[parameters('LS_Azure_SQL_properties_typeProperties_database')]"
					},
					"LS_Azure_SQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_Azure_SQL_properties_typeProperties_userName')]"
					},
					"LS_REST_API_properties_typeProperties_url": {
						"value": "[parameters('LS_REST_API_properties_typeProperties_url')]"
					},
					"LS_OnPrem_SQL_properties_typeProperties_server": {
						"value": "[parameters('LS_OnPrem_SQL_properties_typeProperties_server')]"
					},
					"LS_OnPrem_SQL_properties_typeProperties_database": {
						"value": "[parameters('LS_OnPrem_SQL_properties_typeProperties_database')]"
					},
					"LS_OnPrem_SQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_OnPrem_SQL_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}